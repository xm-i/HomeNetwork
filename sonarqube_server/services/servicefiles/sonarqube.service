[Unit]
Description=SonarQube Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sonarqube
Group=sonarqube
WorkingDirectory=/opt/sonarqube/current
Environment=JAVA_HOME=/usr/lib/jvm/java-25-openjdk-amd64
Environment=ES_TMPDIR=/opt/sonarqube/temp
Environment=LANG=en_US.UTF-8
Environment=LC_ALL=en_US.UTF-8
EnvironmentFile=/opt/sonarqube/env_file
ExecStart=/usr/lib/jvm/java-25-openjdk-amd64/bin/java -jar /opt/sonarqube/current/lib/sonarqube.jar -Dsonar.log.console=true
LimitNOFILE=131072
LimitNPROC=8192
Restart=always
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=60
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
