server{
    listen 80;
    server_name home-server.internal;

    rewrite ^(.*)$ http://dashboard.home-server.internal$1 permanent;
}
server{
    listen 80;
    server_name dashboard.home-server.internal;
    root /var/www/html/dashboard;
    index index.html index.htm;

    location / {
        try_files $uri $uri/ /index.html;
    }
}

server{
    listen 80;
    server_name dashboard-api.home-server.internal;
    location / {
        proxy_pass http://localhost:5000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection keep-alive;
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
server{
    listen 80;
    server_name jenkins.home-server.internal;
    location / {
        proxy_pass http://localhost:8080;
    }
}
server{
    listen 80;
    server_name monitor.home-server.internal grafana.home-server.internal;
    location / {
        proxy_pass http://watch-server.internal:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /api/live/ {
        proxy_pass http://watch-server.internal:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }
}
server{
    listen 80;
    listen 8888;
    server_name recorder.home-server.internal;
    location / {
        proxy_pass http://recorder.internal:8888;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

server{
    listen 80;
    server_name rundeck.home-server.internal;
    location / {
        proxy_pass http://batch-server.internal:4440;
        proxy_set_header X-Forwarded-Host $host:$server_port;
        proxy_set_header X-Forwarded-Server $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

server{
    listen 80;
    server_name pinpon.home-server.internal;
    location / {
        proxy_pass http://pinpon-server.internal:5000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection keep-alive;
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
