map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server{
    listen 80;
    listen 443 ssl;
    server_name home-server.internal;

    ssl_certificate /etc/nginx/certs/_wildcard.home-server.internal+1.pem;
    ssl_certificate_key /etc/nginx/certs/_wildcard.home-server.internal+1-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    rewrite ^(.*)$ $scheme://dashboard.home-server.internal$1 permanent;
}
server{
    listen 80;
    listen 443 ssl;
    server_name dashboard.home-server.internal;

    ssl_certificate /etc/nginx/certs/_wildcard.home-server.internal+1.pem;
    ssl_certificate_key /etc/nginx/certs/_wildcard.home-server.internal+1-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /var/www/html/dashboard;
    index index.html index.htm;

    location / {
        try_files $uri $uri/ /index.html;
    }
}

server{
    listen 80;
    listen 443 ssl;
    server_name dashboard-api.home-server.internal;

    ssl_certificate /etc/nginx/certs/_wildcard.home-server.internal+1.pem;
    ssl_certificate_key /etc/nginx/certs/_wildcard.home-server.internal+1-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://localhost:5000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SignalR / WebSocket 用設定
        proxy_buffering off;
        proxy_read_timeout 100s;
    }
}
