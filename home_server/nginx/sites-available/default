# 移行期間用: 旧ドメイン (home-server.internal / *.home-server.internal) から新ドメインへリダイレクト
# API 等の POST リクエストでもメソッドが維持されるよう 307 を使用
server{
    listen 443 ssl;
    server_name home-server.internal;

    ssl_certificate /etc/nginx/certs/_wildcard.home-server.internal+1.pem;
    ssl_certificate_key /etc/nginx/certs/_wildcard.home-server.internal+1-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    return 307 https://dashboard.home.internal$request_uri;
}

server{
    listen 443 ssl;
    listen 8888;
    server_name ~^(?<subdomain>dashboard|dashboard-api|jenkins|monitor|grafana|recorder|rundeck|pinpon|sonarqube)\.home-server\.internal$;

    ssl_certificate /etc/nginx/certs/_wildcard.home-server.internal+1.pem;
    ssl_certificate_key /etc/nginx/certs/_wildcard.home-server.internal+1-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    return 307 https://$subdomain.home.internal$request_uri;
}
