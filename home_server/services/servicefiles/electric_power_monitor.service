[Unit]
Description = Electric Power Monitor Service
After=network-online.target nginx.service back_end_api.service
Wants=network-online.target

[Service]
WorkingDirectory=/opt/electric-power-monitor-service
ExecStart=/usr/bin/dotnet /opt/electric-power-monitor-service/ElectricPowerMonitorService.dll
Restart=always
RestartSec=5s
Type=simple

[Install]
WantedBy=multi-user.target