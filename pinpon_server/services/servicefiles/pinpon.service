[Unit]
Description = Pinpon Service (.NET 10)
After=network.target

[Service]
WorkingDirectory=/opt/pinpon
ExecStart=/usr/bin/dotnet /opt/pinpon/Pinpon.Web.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=pinpon-service
User=pinpon
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=ASPNETCORE_URLS=http://0.0.0.0:5000

[Install]
WantedBy=multi-user.target
