FROM docker.io/jenkins/jenkins:lts-jdk25

USER root

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ansible \
      git \
      openssh-client \
      sshpass \
      rsync \
      ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    ansible-galaxy collection install -p /usr/share/ansible/collections \
      community.postgresql \
      community.general \
      ansible.posix && \
    chmod -R a+rX /usr/share/ansible/collections && \
    mkdir -p /var/lib && \
    rm -rf /var/lib/jenkins && \
    ln -s /var/jenkins_home /var/lib/jenkins

USER jenkins
