[Unit]
Description=Jenkins Container (Podman)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=45
ExecStartPre=-/usr/bin/podman rm -f jenkins
ExecStart=/usr/bin/podman run --rm --name jenkins \
  -p 8080:8080 \
  -p 50000:50000 \
  -e TZ=Asia/Tokyo \
  -e "JAVA_OPTS=-Duser.timezone=Asia/Tokyo" \
  -v /opt/jenkins/home:/var/jenkins_home \
  localhost/jenkins-custom:lts-jdk25
ExecStop=/usr/bin/podman stop -t 30 jenkins

[Install]
WantedBy=multi-user.target
