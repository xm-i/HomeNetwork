[Unit]
Description=DNS Filter Service (AdGuard Home)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/dnsfilter/bin/AdGuardHome --no-check-update -c /opt/dnsfilter/conf/AdGuardHome.yaml -w /opt/dnsfilter/work
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
