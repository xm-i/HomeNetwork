[Unit]
Description=DHCP Lease Web Viewer
After=network.target

[Service]
User=dns
Group=dns
WorkingDirectory=/home/dns/services/dhcp_web
ExecStart=/usr/bin/python3 /home/dns/services/dhcp_web/dhcp_web.py
Restart=always
Type=simple
# 一般ユーザーdnsで特権ポート80をバインドするための設定
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
